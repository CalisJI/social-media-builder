{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "phase", "type", "priority", "status", "owner", "issueNumber", "pullRequestNumber", "dependsOn", "unlocks", "capabilities", "acceptanceCriteria", "requiredEvidence", "risk", "blockedReason", "startedAt", "completedAt", "verifiedAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "type": {"enum": ["feature", "quality", "governance"]},
    "priority": {"enum": ["low", "medium", "high", "critical"]},
    "status": {"enum": ["backlog", "ready", "in_progress", "in_review", "merged", "verified", "released", "blocked", "cancelled"]},
    "owner": {"type": ["string", "null"]},
    "issueNumber": {"type": ["integer", "null"]},
    "pullRequestNumber": {"type": ["integer", "null"]},
    "dependsOn": {"type": "array", "items": {"type": "string"}},
    "unlocks": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requiredEvidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk": {"enum": ["low", "medium", "high"]},
    "blockedReason": {"type": ["string", "null"]},
    "startedAt": {"type": ["string", "null"]},
    "completedAt": {"type": ["string", "null"]},
    "verifiedAt": {"type": ["string", "null"]}
  }
}
