{
  "id": "vocabulary-mistake-correction-scene-v2",
  "engine": "scene-v2",
  "templateSchemaVersion": 2,
  "capabilities": ["mistakeCorrection"],
  "compatibleStrategies": ["mistake-correction-v1"],
  "assets": {
    "background": "assets/background.png",
    "petal": "assets/petal.png"
  },
  "tokens": {
    "colors": { "ink": "#27243A", "secondary": "#625D78", "accent": "#E85D75", "card": "#FFF8EC" },
    "typography": { "body": { "fontSize": 36, "weight": "bold" } },
    "spacing": { "6": 24 }, "radius": { "card": 32 }, "shadows": { "card": "none" }, "motion": { "enter": { "duration": 0.5 } }
  },
  "layout": {
    "safeZone": [80, 220, 920, 1500]
  },
  "constraints": {
    "brand_handle": { "maxLength": 32 },
    "word": { "maxLength": 24 },
    "ipa": { "maxLength": 48 },
    "part_of_speech": { "maxLength": 24 },
    "meaning_vi": { "maxLength": 360 },
    "common_mistake": { "maxLength": 360 },
    "corrected_usage": { "maxLength": 360 },
    "example_en": { "maxLength": 240 },
    "example_vi": { "maxLength": 240 },
    "cta": { "maxLength": 54 }
  },
  "copy": {
    "hook": "SỬA LỖI THƯỜNG GẶP",
    "meaningLabel": "NGHĨA ĐÚNG",
    "exampleLabel": "VÍ DỤ",
    "cta": "Follow {handle} • 1 từ mỗi ngày"
  },
  "timeline": {
    "hook": [0, 0.55],
    "word": [0.8, 0.45],
    "meaning": [2.2, 0.5],
    "example": [4, 0.5],
    "cta": [7.2, 0.65]
  },
  "scene": [
    { "type": "image", "asset": "assets/petal.png", "x": 55, "y": 330, "width": 96, "height": 96 },
    { "type": "box", "x": 96, "y": 300, "width": 888, "height": 1150, "color": "$colors.card", "opacity": 0.96 },
    { "type": "text", "text": "SỬA LỖI THƯỜNG GẶP", "x": 260, "y": 230, "fontSize": 36, "weight": "bold", "color": "$colors.ink", "animations": [{ "type": "fade-in", "start": 0, "duration": 0.5 }] },
    { "type": "text", "text": "{word}", "x": 140, "y": 405, "fontSize": 88, "weight": "extraBold", "color": "$colors.ink", "animations": [{ "type": "fade-in", "start": 0, "duration": 0.5 }] },
    { "type": "wrong-right", "x": 148, "y": 650, "width": 784, "maxHeight": 210, "wrongText": "{common_mistake}", "rightText": "{corrected_usage}", "wrongColor": "$colors.accent", "rightColor": "#2E8B57", "wrongAnimations": [{ "type": "fade-in", "start": 0, "duration": 0.5 }, { "type": "fade-out", "start": 2.5, "duration": 0.2 }], "rightAnimations": [{ "type": "fade-in", "start": 3.2, "duration": 0.5 }] },
    { "type": "text", "text": "DỪNG LẠI — SAI RỒI!", "x": 270, "y": 840, "fontSize": 32, "weight": "extraBold", "color": "$colors.accent", "animations": [{ "type": "fade-in", "start": 2.5, "duration": 0.2 }, { "type": "fade-out", "start": 3.1, "duration": 0.1 }] },
    { "type": "text", "text": "GIẢI THÍCH", "x": 148, "y": 1030, "fontSize": 26, "weight": "bold", "color": "$colors.secondary", "animations": [{ "type": "fade-in", "start": 4.2, "duration": 0.5 }] },
    { "type": "text", "text": "{meaning}", "x": 148, "y": 1075, "fontSize": 38, "maxWidth": 784, "maxHeight": 100, "maxLines": 2, "minFontSize": 28, "overflowPolicy": "shrink", "weight": "bold", "color": "$colors.ink", "lineSpacing": 10, "animations": [{ "type": "fade-in", "start": 4.2, "duration": 0.5 }, { "type": "slide-up", "start": 4.2, "duration": 0.5, "distance": 24 }] },
    { "type": "text", "text": "VÍ DỤ", "x": 148, "y": 1200, "fontSize": 26, "weight": "bold", "color": "$colors.secondary", "animations": [{ "type": "fade-in", "start": 5.3, "duration": 0.5 }] },
    { "type": "text", "text": "{exampleEn}", "x": 148, "y": 1245, "fontSize": 30, "maxWidth": 784, "maxHeight": 85, "maxLines": 2, "minFontSize": 22, "overflowPolicy": "shrink", "weight": "medium", "color": "$colors.ink", "lineSpacing": 8, "animations": [{ "type": "fade-in", "start": 5.3, "duration": 0.5 }, { "type": "slide-up", "start": 5.3, "duration": 0.5, "distance": 24 }] },
    { "type": "text", "text": "{cta}", "x": 202, "y": 1395, "fontSize": 30, "weight": "bold", "color": "$colors.ink", "animations": [{ "type": "fade-in", "start": 7.2, "duration": 0.65 }, { "type": "slide-up", "start": 7.2, "duration": 0.65, "distance": 36 }] }
  ]
}
