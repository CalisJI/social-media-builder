{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-media-builder.local/schemas/template.schema.json",
  "title": "Video Template DSL v1",
  "type": "object",
  "required": [
    "templateId",
    "version",
    "contentType",
    "platformProfiles",
    "tokens",
    "scenes"
  ],
  "properties": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contentType": {
      "enum": [
        "vocabulary"
      ]
    },
    "platformProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "type": "object"
    },
    "audioPresetId": {
      "type": "string"
    },
    "userControls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "semanticType",
          "duration",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "semanticType": {
            "type": "string"
          },
          "duration": {
            "type": "object",
            "required": [
              "preferredMs",
              "minMs",
              "maxMs"
            ],
            "properties": {
              "preferredMs": {
                "type": "integer",
                "minimum": 100
              },
              "minMs": {
                "type": "integer",
                "minimum": 100
              },
              "maxMs": {
                "type": "integer",
                "minimum": 100
              }
            }
          },
          "transitionIn": {
            "type": "string"
          },
          "transitionOut": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "audioCues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "bounds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "group",
            "stack",
            "grid",
            "card",
            "shape",
            "text",
            "richText",
            "image",
            "video",
            "icon",
            "lottie",
            "progress",
            "waveform",
            "brandMark"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "binding": {
          "type": "string"
        },
        "style": {
          "type": "object"
        },
        "motionPreset": {
          "type": "string"
        },
        "visibility": {
          "type": "object"
        },
        "textLayout": {
          "type": "object",
          "properties": {
            "preferredFontSize": {
              "type": "number"
            },
            "minFontSize": {
              "type": "number"
            },
            "maxLines": {
              "type": "integer",
              "minimum": 1
            },
            "overflowStrategy": {
              "enum": [
                "wrap",
                "balance-wrap",
                "shrink-to-min",
                "layout-variant",
                "split-scene",
                "fail-validation"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}

